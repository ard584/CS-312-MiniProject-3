<!DOCTYPE html>
<html lang="en">
<head>
	<link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">
	<link rel="stylesheet" href ="/style.css">
</head>

<body>
	<h1 class="text-center">
		Take a Seat
	</h1>

	<div class = "card m-3" style="max-width: 250px;">
		<div class = "card-body">


			<!-- error message -->
			<% if (error) { %>
				<p class="text-danger"><%= error %></p>
			<% } %>
				
			<form action="/signin" method = "POST">

				<label for = "user_id">User ID</label>
				<input type="text" id="user_id" name="user_id" class="form-control mb-2" required>

				<label for = "password">Password</label>
				<input type="password" id="password" name="password" class="form-control mb-2" required>

				<button type="submit" class="btn btn-primary">Sign In</button>

			</form>

			<p class = "mt-3">New to the party? <a href = "/signin">Go to initiation</a></p>

		</div>

	</div>

</body>
</html>
