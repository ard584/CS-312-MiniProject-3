<!DOCTYPE html>
<html lang="en">
<head>
	<link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">
	<link rel="stylesheet" href ="/style.css">
</head>

<body>
	<h1 class="text-center">
		10/6 Blog
	</h1>

	<h2 class="text-center">
		Welcome to the tea party!
	</h2>

	<p class="text-center">
		Welcome back <%= name %> | <a href="/signout">Sign out</a>
	</p>

	<div class="d-flex flex-wrap">

		<form action= "/posts" method = "POST">

			<div class = "card m-3" style="max-width: 250px;">
				<div class = "card-body">
				
					<label for="title">
						Post Title
					</label>
					<input type="text" id="title" name="title" required>

					<label for="content">
						Post Content
					</label>
					<textarea id="content" name="content" placeholder="Go on, spill the tea..." required></textarea>

					<label for="creator">
						Creator
					</label>
					<input type="text" id="creator" name="creator" required>

					<button type="submit" class="btn btn-primary">Post</button>

				</div>
			</div>

		</form>

		<% posts.forEach(function(post) { %>

			<div class = "card m-3" style="max-width: 250px;">
				<div class = "card-body">

					<label>Post Title</label>
					<p><%= post.title %></p>

					<label>Post Content</label>
					<p><%= post.body %></p>

					<label>Creator</label>
					<p><%= post.creator_name %></p>

					<label>Date</label>
					<p><%= post.date_created %></p>

					<a href="/posts/<%= post.blog_id %>/edit">Edit post</a>

					<form action="/posts/<%= post.blog_id %>/delete" method ="POST">
						<button type="submit">Delete post</button>
					</form>

				</div>
			</div>

		<% }); %>

	</div>

</body>
</html>