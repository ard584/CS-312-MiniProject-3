<!DOCTYPE html>
<html lang="en">
<head>
	<link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">
	<link rel="stylesheet" href ="/style.css">
</head>

<body>
	<h1 class="text-center">
		Initiation
	</h1>

	<div class = "card m-3" style="max-width: 250px;">
		<div class = "card-body">


			<!-- error message -->
			<% if (error) { %>
				<p class="text-danger"><%= error %></p>
			<% } %>
				
			<form action="/signup" method = "POST">

				<label for = "user_id">User ID</label>
				<input type="text" id="user_id" name="user_id" class="form-control mb-2" required>

				<label for = "password">Password</label>
				<input type="password" id="password" name="password" class="form-control mb-2" required>

				<label for = "name">Name</label>
				<input type="text" id="name" name="name" class="form-control mb-3" required>

				<button type="submit" class="btn btn-primary">Sign Up</button>

			</form>

			<p class = "mt-3">Already have a cup? <a href = "/signin">Take a seat</a></p>

		</div>

	</div>

</body>
</html>
